# Open a visualization driver (TSG for terminal-based; use OGL for OpenGL window)
/vis/open OGL 600x600-0+0

/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/process/verbose 0

# Turn off auto-refresh while setting up the scene
/vis/viewer/set/autoRefresh false
/vis/verbose errors

# Draw your geometry
/vis/drawVolume

# Set viewing angle and lighting
/vis/viewer/set/viewpointVector -1 -1 -1
/vis/viewer/set/lightsVector -1 0 0

# Set rendering style
/vis/viewer/set/style surface
#/vis/viewer/set/style wireframe
/vis/viewer/set/auxiliaryEdge true

# Show particle trajectories
/vis/scene/add/trajectories
/tracking/storeTrajectory 1
/vis/scene/endOfEventAction accumulate

# Color code by particle type
/vis/modeling/trajectories/create/drawByParticleID
/vis/modeling/trajectories/drawByParticleID-0/set gamma green
/vis/modeling/trajectories/drawByParticleID-0/set neutron white
/vis/modeling/trajectories/drawByParticleID-0/set alpha yellow
/vis/modeling/trajectories/drawByParticleID-0/set e- red
/vis/modeling/trajectories/drawByParticleID-0/set e+ blue
/vis/modeling/trajectories/drawByParticleID-0/set GenericIon grey

# Axes at the origin
/vis/scene/add/axes 0 0 0 15 cm

# Finalize setup
/vis/viewer/set/autoRefresh true
/vis/viewer/refresh
